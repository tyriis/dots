{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "agent": {
    // "build": { "disable": true },
    // "plan": { "disable": true }
  },
  "autoupdate": "notify",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "oh-my-opencode-slim",
    // "@upstash/context7-opencode",
    // "opencode-mem",
    // "opencode-skill-creator",
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {file:~/secrets/opencode-ctx7-token}",
      },
    },
    "home-assistant": {
      "enabled": true,
      "type": "remote",
      "url": "https://hass.techtales.io/api/mcp",
      "oauth": {
        "clientId": "http://localhost:19876",
        "redirectUri": "http://localhost:19876/mcp/oauth/callback",
      },
    },
  },
  "lsp": true,
  "small_model": "techtales/qwen3.8-flash-next",
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.config/gh/config.yml*": "ask",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow",
      "*secret*": "ask",
      "*external-secret.yaml": "allow",
      "documents/obsidian*": "allow",
    },
    "edit": "allow",
    "bash": {
      "*": "allow",
      "gh pr list*": "allow",
      "gh pr diff*": "allow",
      "gh search prs*": "allow",
      "gh pr view*": "allow",
      "gh release list*": "allow",
      "git add *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git branch *": "allow",
      "yamllint *": "allow",
      "kubectl config current-context*": "allow",
      "kubectl get pod*": "allow",
      "kubectl describe pod*": "allow",
      "kubectl logs*": "allow",
      "kubectl get helmreleases*": "allow",
      "*.config/gh/config.yml*": "ask",
      "*secret*": "ask",
      "gh pr comment*": "ask",
      "kubectl get secret*": "ask",
      "sudo *": "deny",
      "sudo*": "deny",
    },
    "glob": "allow",
    "grep": "allow",
    "task": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "lsp": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": {
      "*": "ask",
      "/tmp/opencode": "allow",
      "/tmp/opencode/**": "allow",
      "/home/nils/documents/obsidian/knowledge": "allow",
      "/home/nils/documents/obsidian/knowledge/**": "allow",
    },
    "doom_loop": "ask",
  },
  // V2 permission rules, merged after the deprecated `permission` object.
  // Last match wins; the allows below override the catch-all ask.
  "permissions": [
    // Restore the external-directory prompt upstream removed in PR #53585
    // (shipped in v2.0.25). Keep in sync with the v1 block above.
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "/tmp/opencode/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/research/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/documents/obsidian/knowledge/*", "effect": "allow" },
    // opencode materialises git+ plugins (superpowers et al.) under
    // ~/.cache/opencode/ and reads their skill files at runtime; without
    // this rule every skill load trips the catch-all ask.
    { "action": "external_directory", "resource": "~/.cache/opencode/*", "effect": "allow" },
  ],
  "provider": {
    "techtales": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "techtales",
      "options": {
        "baseURL": "https://techtales.ai/v1",
        "apiKey": "{file:~/secrets/opencode-techtales-token}",
      },
      "models": {
        "qwen3.8-flash-next": {
          "name": "Qwen3.8 Flash Next",
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "tool_call": true,
          "reasoning": true,
          "temperature": true,
          "limit": { "context": 262144, "output": 64000 },
          "cost": { "input": 0.15, "output": 0.47, "cache_read": 0.016, "cache_write": 0.2 },
          // Base (no-variant) requests — OpenChamber's "default" — run medium
          // instead of the gateway's xhigh default.
          "options": { "reasoningEffort": "medium" },
          // Gateway supports reasoning_effort: xhigh (default), medium, low.
          // Explicit variant selections override `options` above.
          "variants": {
            "thinking": { "reasoningEffort": "medium" },
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "xhigh": { "reasoningEffort": "xhigh" },
          },
        },
      },
    },
  },
  "disabled_providers": [
    "opencode"
  ],
}
