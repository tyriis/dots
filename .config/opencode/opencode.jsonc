{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "agent": {
    "build": { "disable": true },
    "plan": { "disable": true },
  },
  "autoupdate": "notify",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@devtheops/opencode-plugin-otel",
    // "opencode-mem",
    // "opencode-skill-creator",
    "@williamcr01/opencode-tps",
  ],
  "mcp": {
    "home-assistant": {
      "enabled": true,
      "type": "remote",
      "url": "https://hass.techtales.io/api/mcp",
      "oauth": {
        "clientId": "http://localhost:19876",
        "redirectUri": "http://localhost:19876/mcp/oauth/callback",
      },
    },
  },
  "lsp": true,
  // "small_model": "opencode-go/deepseek-v4-flash",
  "small_model": "unsloth/unsloth/gemma-4-E4B-it-GGUF:UD-Q4_K_XL",
  // "small_model": "llamacpp/qwen2.5-7b-instruct-q3_k_m.gguf",
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.config/gh/config.yml*": "ask",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow",
      "*secret*": "ask",
      "*external-secret.yaml": "allow",
      "documents/obsidian*": "allow",
    },
    "edit": "allow",
    "bash": {
      "*": "allow",
      "gh pr list*": "allow",
      "gh pr diff*": "allow",
      "gh search prs*": "allow",
      "gh pr view*": "allow",
      "gh release list*": "allow",
      "git add *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git branch *": "allow",
      "yamllint *": "allow",
      "kubectl config current-context*": "allow",
      "kubectl get pod*": "allow",
      "kubectl describe pod*": "allow",
      "kubectl logs*": "allow",
      "kubectl get helmreleases*": "allow",
      "*.config/gh/config.yml*": "ask",
      "*secret*": "ask",
      "gh pr comment*": "ask",
      "kubectl get secret*": "ask",
      "sudo *": "deny",
      "sudo*": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "task": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "lsp": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": {
      "*": "ask",
      "/tmp/opencode": "allow",
      "/tmp/opencode/**": "allow"
    },
    "doom_loop": "ask",
  },
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Llama.cpp Local Server",
      "options": {
        "baseURL": "http://localhost:8085/v1",
      },
      "models": {
        "qwen2.5-7b-instruct-q3_k_m.gguf": {
          "name": "Qwen 2.5 VL 7b (local)",
        },
      },
    },
    "unsloth": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "unsloth localhost",
      "options": {
        "baseURL": "http://localhost:8000/v1",
        "apiKey": "{file:~/secrets/opencode-unsloth-token}",
      },
      "models": {
        "unsloth/gemma-4-E4B-it-GGUF:UD-Q4_K_XL": {
          "name": "Gemma 4 E4B it",
          "limit": {
            "context": 131072,
            "output": 8192
          },
      },
    },
  },
}
